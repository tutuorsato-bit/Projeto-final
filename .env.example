# Local development can use SQLite. For deployment, use PostgreSQL.
DATABASE_URL=sqlite:///./data/modstation.db
SECRET_KEY=
APP_ENV=development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=http://localhost:8000
API_URL=http://localhost:8000
MAX_UPLOAD_BYTES=20971520
STORAGE_ROOT=./storage
QUARANTINE_ROOT=./quarantine

# Both scanners are required for an approval; missing scanner/rules => inconclusive.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
YARA_RULES_PATH=./security/rules.yar
VIRUSTOTAL_API_KEY=

# Optional SMTP for verification/reset emails. Never log or return tokens.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ModStation <noreply@example.invalid>"
REQUIRE_EMAIL_VERIFICATION=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
POSTGRES_USER=modstation
POSTGRES_DB=modstation
POSTGRES_PASSWORD=dev-local-only-change-me

# Create the first administrator only with: python -m app.cli create-admin
