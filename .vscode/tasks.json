{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start ModStation",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "set -a; source .env; set +a; alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "modstation",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running on",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
